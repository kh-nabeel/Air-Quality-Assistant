# Firebase Web Config (public client-side values, NOT secrets)
# These are protected by Firebase App Check + security rules
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# ReCAPTCHA Enterprise / Google Cloud Fraud Defense Key (or v3 site key)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_enterprise_web_key
# App Check provider: 'enterprise' (default, for Google Cloud Fraud Defense) or 'v3'
VITE_APP_CHECK_PROVIDER=enterprise
# App Check debug token for local development (generate in Firebase console)
VITE_APP_CHECK_DEBUG_TOKEN=your_app_check_debug_token
